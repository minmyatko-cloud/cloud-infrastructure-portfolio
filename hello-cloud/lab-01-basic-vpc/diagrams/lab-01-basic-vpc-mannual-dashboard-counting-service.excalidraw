      "link": null,
      "locked": false,
      "text": "## systemd - dashboard\n\n[Unit]\nDescription=Consul Demo Dashboard Service\nAfter=network.target\n\n[Service]\nType=simple\nUser=dashboard-user\nGroup=dashboard-user\nWorkingDirectory=/opt/dashboard\nEnvironmnet=\"PORT=4000\"\nEnvironment=\"COUNTING_SERVICE_URL=http://internal-counting-alb-989478984.ap-southeast-1.elb.amazonaws.com\"\nExecStart=/opt/dashboard/dashboard-service\nRestart=always\nRestartSec=5\n\n[Install]\nWantedBy=multi-user.target",
      "fontSize": 19.412108564477077,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "## systemd - dashboard\n\n[Unit]\nDescription=Consul Demo Dashboard Service\nAfter=network.target\n\n[Service]\nType=simple\nUser=dashboard-user\nGroup=dashboard-user\nWorkingDirectory=/opt/dashboard\nEnvironmnet=\"PORT=4000\"\nEnvironment=\"COUNTING_SERVICE_URL=http://internal-counting-alb-989478984.ap-southeast-1.elb.amazonaws.com\"\nExecStart=/opt/dashboard/dashboard-service\nRestart=always\nRestartSec=5\n\n[Install]\nWantedBy=multi-user.target",
      "autoResize": true,
