      "boundElements": null,
      "updated": 1790701976134,
      "created": 1790655187908,
      "link": null,
      "locked": false,
      "text": "openssl genpkey -algorithm RSA -aes-256-cbc -pkeyopt rsa_keygen_bits:4096 -out private/mmkcloud-root-ca.key",
      "fontSize": 15.326903484463402,
      "baseFontSize": null,
      "fontFamily": 8,
