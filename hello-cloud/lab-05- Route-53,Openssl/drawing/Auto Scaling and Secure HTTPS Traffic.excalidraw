      "labelPosition": null
    },
    {
      "id": "IykMW4YsucspypAezwGLa",
      "type": "text",
      "x": -1475.6526792026984,
      "y": 3548.6546273602335,
      "width": 626.9991455078125,
      "height": 250,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bDX",
      "roundness": null,
      "seed": 1972120556,
      "version": 340,
      "versionNonce": 1260449879,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790701976134,
      "created": 1790655149432,
      "link": null,
      "locked": false,
      "text": "Openssl req \\\n  -x509 \\\n  -new \\\n  -sha256 \\\n  -days 3650 \\\n  -key private/mmkcloud-root-ca.key \\\n  -out certs/mmkcloud-root-ca.crt \\\n  -subj \"/C=MY/O=MMK Cloud /CN=MMK Cloud Root CA\" \\\n  -addext \"basicConstraints=critical,CA:TRUE,pathlen:0\" \\\n  -addext \"keyUsage=critical,keyCertSign,cRLSign\"",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Openssl req \\\n  -x509 \\\n  -new \\\n  -sha256 \\\n  -days 3650 \\\n  -key private/mmkcloud-root-ca.key \\\n  -out certs/mmkcloud-root-ca.crt \\\n  -subj \"/C=MY/O=MMK Cloud /CN=MMK Cloud Root CA\" \\\n  -addext \"basicConstraints=critical,CA:TRUE,pathlen:0\" \\\n  -addext \"keyUsage=critical,keyCertSign,cRLSign\"",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "Bb1QkmT7cf3ncxvLS6OJp",
      "type": "text",
      "x": -1470.256974196705,
      "y": 3443.7950224790848,
      "width": 901.9870539367375,
      "height": 19.158629355579247,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
