      "text": "#Generate the encrypted Root CA private key",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "#Generate the encrypted Root CA private key",
