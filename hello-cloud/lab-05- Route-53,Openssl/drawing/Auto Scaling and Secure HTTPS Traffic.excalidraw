      "created": 1790677689124,
      "link": null,
      "locked": false,
      "text": "openssl x509 \\\n  -req \\\n  -sha256 \\\n  -days 365 \\\n  -in csr/counting.mmkcloud.ai.csr \\\n  -CA certs/mmkcloud-root-ca.crt \\\n  -CAkey private/mmkcloud-root-ca.key \\\n  -CAcreateserial \\\n  -out certs/counting.mmkcloud.ai.crt \\\n  -extfile counting-ext.cnf",
