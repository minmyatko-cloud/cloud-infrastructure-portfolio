            "tags": {
              "Name": "lon-web-svr-1"
            },
            "tags_all": {
              "ManagedBy": "Terraform",
              "Name": "lon-web-svr-1",
              "Project": "lab-07-route53-geolocation-routing-policy"
            },
            "tenancy": "default",
            "timeouts": null,
            "user_data": "#!/bin/bash\nset -euo pipefail\n\nexec \u003e /var/log/user-data.log 2\u003e\u00261\numask 077\n\n# Install Apache, TLS support, and JSON tools\ndnf install -y httpd mod_ssl openssl jq\n\n# Retrieve this server's current certificate bundle\nCERT_BUNDLE=$(mktemp)\ntrap 'rm -f \"$CERT_BUNDLE\"' EXIT\n\naws secretsmanager get-secret-value \\\n  --region \"eu-west-2\" \\\n  --secret-id \"lab-07-route53-geolocation/lon-web-svr-1/tls\" \\\n  --version-stage AWSCURRENT \\\n  --query SecretString \\\n  --output text \\\n  --no-cli-pager \u003e \"$CERT_BUNDLE\"\n\n# Install the certificate, private key, and root CA\ninstall -d -m 700 /etc/pki/tls/private\n\njq -er '.certificate' \"$CERT_BUNDLE\" \\\n  \u003e /etc/pki/tls/certs/lab-web.crt\n\njq -er '.private_key' \"$CERT_BUNDLE\" \\\n  \u003e /etc/pki/tls/private/lab-web.key\n\njq -er '.root_ca' \"$CERT_BUNDLE\" \\\n  \u003e /etc/pki/tls/certs/lab-root-ca.crt\n\nchmod 600 /etc/pki/tls/private/lab-web.key\nchmod 644 \\\n  /etc/pki/tls/certs/lab-web.crt \\\n  /etc/pki/tls/certs/lab-root-ca.crt\n\n# Verify the server certificate against the supplied root CA\nopenssl verify \\\n  -CAfile /etc/pki/tls/certs/lab-root-ca.crt \\\n  -purpose sslserver \\\n  /etc/pki/tls/certs/lab-web.crt\n\n# Create the simple regional page\ncat \u003e /var/www/html/index.html \u003c\u003c'HTML'\n\u003c!doctype html\u003e\n\u003chtml lang=\"en\"\u003e\n\u003chead\u003e\n  \u003cmeta charset=\"utf-8\"\u003e\n  \u003cmeta name=\"viewport\" content=\"width=device-width, initial-scale=1\"\u003e\n  \u003ctitle\u003eRoute 53 Geolocation Lab\u003c/title\u003e\n  \u003cstyle\u003e\n    body {\n      margin: 0;\n      min-height: 100vh;\n      display: grid;\n      place-items: center;\n      background: #EDE9FE;\n      color: #182230;\n      font-family: Arial, sans-serif;\n      text-align: center;\n    }\n\n    main {\n      padding: 32px;\n    }\n\n    h1 {\n      font-size: 36px;\n    }\n\n    p {\n      font-size: 24px;\n    }\n  \u003c/style\u003e\n\u003c/head\u003e\n\u003cbody\u003e\n  \u003cmain\u003e\n    \u003ch1\u003eRoute 53 Geolocation Lab\u003c/h1\u003e\n    \u003cp\u003eThis is London Web Server 1\u003c/p\u003e\n  \u003c/main\u003e\n\u003c/body\u003e\n\u003c/html\u003e\nHTML\n\nprintf 'ok\\n' \u003e /var/www/html/health.html\nchmod 644 /var/www/html/index.html /var/www/html/health.html\n\n# Disable Apache's default HTTP listener\nsed -i \\\n  's/^[[:space:]]*Listen[[:space:]]\\+80[[:space:]]*$/# HTTP disabled/' \\\n  /etc/httpd/conf/httpd.conf\n\n# Configure HTTPS\ncat \u003e /etc/httpd/conf.d/ssl.conf \u003c\u003c'APACHE'\nListen 443 https\n\nSSLSessionCache shmcb:/run/httpd/sslcache(512000)\nSSLSessionCacheTimeout 300\n\n\u003cVirtualHost *:443\u003e\n    ServerName geo.minracle.com\n    DocumentRoot \"/var/www/html\"\n\n    SSLEngine on\n    SSLProtocol -all +TLSv1.2 +TLSv1.3\n\n    SSLCertificateFile /etc/pki/tls/certs/lab-web.crt\n    SSLCertificateKeyFile /etc/pki/tls/private/lab-web.key\n\n    \u003cDirectory \"/var/www/html\"\u003e\n        Require all granted\n        AllowOverride None\n        Options -Indexes\n    \u003c/Directory\u003e\n\n    ErrorLog /var/log/httpd/ssl_error_log\n    CustomLog /var/log/httpd/ssl_access_log combined\n\u003c/VirtualHost\u003e\nAPACHE\n\nrestorecon -RF /etc/pki/tls /var/www/html\n\n# Validate and start services\nhttpd -t\nsystemctl enable httpd\nsystemctl restart httpd\nsystemctl enable --now amazon-ssm-agent\n\n# Test HTTPS locally using the actual application hostname\ncurl \\\n  --fail \\\n  --silent \\\n  --show-error \\\n  --retry 5 \\\n  --retry-connrefused \\\n  --retry-delay 2 \\\n  --cacert /etc/pki/tls/certs/lab-root-ca.crt \\\n  --resolve geo.minracle.com:443:127.0.0.1 \\\n  https://geo.minracle.com/health.html",
            "user_data_base64": null,
            "user_data_replace_on_change": true,
            "volume_tags": null,
            "vpc_security_group_ids": [
              "sg-011c2d7a5489a057a"
            ]
          },
