    {
      "id": "S5F-67QtIyhrzRFngwN3s",
      "type": "text",
      "x": -3971.233607254926,
      "y": 4507.560270245608,
      "width": 814.3391621907555,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bBe",
      "roundness": null,
      "seed": 2124936352,
      "version": 79,
      "versionNonce": 1479739552,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790329231718,
      "created": 1790325835169,
      "link": null,
      "locked": false,
      "text": "aws acm-pca get-certificate-authority-certificate \\\n  --certificate-authority-arn <PRIVATE-CA-ARN> \\\n  --region ap-southeast-1 \\\n  --query Certificate \\\n  --output text > root-ca.crt",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "aws acm-pca get-certificate-authority-certificate \\\n  --certificate-authority-arn <PRIVATE-CA-ARN> \\\n  --region ap-southeast-1 \\\n  --query Certificate \\\n  --output text > root-ca.crt",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "tyQl5J0NwwLhtmyCr7vUV",
      "type": "text",
      "x": -3986.7790200620443,
      "y": 4340.658140494917,
      "width": 1029.6021728515625,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
