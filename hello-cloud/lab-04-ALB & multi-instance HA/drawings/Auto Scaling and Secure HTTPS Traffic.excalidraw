      "created": 1790327883974,
      "link": null,
      "locked": false,
      "text": "aws acm-pca list-certificate-authorities \\\n  --region ap-southeast-1 \\\n  --query 'CertificateAuthorities[?Type==`ROOT`].[CertificateAuthorityConfiguration.Subject.CommonName,Arn,Status]' \\\n  --output table",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
